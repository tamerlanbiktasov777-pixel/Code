
async def sensors(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not allowed(update):
        return

    await update.message.reply_text("Получаю данные Aqara...")

    try:
        states = await asyncio.to_thread(get_ha_states)

        keywords = (
            "aqara", "door", "window", "motion",
            "движ", "двер", "окн", "температур",
            "влажност", "tvoc", "air quality",
        )

        lines = []

        for item in states:
            entity_id = item.get("entity_id", "")
            attrs = item.get("attributes", {})
            name = attrs.get("friendly_name", entity_id)

            if any(word in (entity_id + " " + name).lower()
                   for word in keywords):
                state = item.get("state", "unknown")
                unit = attrs.get("unit_of_measurement", "")
                lines.append(f"• {name}: {state} {unit}".strip())

        if lines:
            message = "📡 Датчики Aqara и связанные устройства:\n\n"
            message += "\n".join(lines)
        else:
            message = (
                "Не нашёл датчики по названиям.\n"
                "Возможно, устройства называются иначе в Home Assistant."
            )

        await update.message.reply_text(message[:4000])

    except Exception as error:
        print("Home Assistant error:", repr(error))
        await update.message.reply_text(
            "Не удалось получить данные Home Assistant. "
            "Проверь HA_URL, HA_TOKEN и доступность Home Assistant."
        )
